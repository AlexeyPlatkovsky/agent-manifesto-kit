+std::expected<motion_data, std::string> model::generate_text_keyposes(
+    std::string_view utf8_prompt, std::span<const pose_key> keys, unsigned frames, unsigned steps,
+    std::uint64_t seed, float text_cfg, float constraint_cfg) const {
+#ifdef KIMODO_HAVE_GGML
+    if (!impl_->text) return std::unexpected("model was loaded without a native text bundle");
+    if (frames < 2 || frames > 10000) return std::unexpected("frames must be in 2..10000");
+    if (steps == 0 || steps > 1000) return std::unexpected("diffusion_steps must be in 1..1000");
+    if (!std::isfinite(text_cfg) || !std::isfinite(constraint_cfg)) return std::unexpected("CFG weights must be finite");
+    const auto &s = *impl_->skeleton;
+    const size_t D = s.motion_dim(), J = s.joints(), body = s.body_dim();
+    for (const auto &key : keys) {
+        if (key.frame >= frames) return std::unexpected("key pose frame outside the clip");
+        if (key.local_axis_angle.size() != J*3)
+            return std::unexpected("key pose needs " + std::to_string(J) + " joint rotations");
+        for (float v : key.local_axis_angle) if (!std::isfinite(v)) return std::unexpected("key pose rotation is not finite");
+        for (float v : key.root_position) if (!std::isfinite(v)) return std::unexpected("key pose root is not finite");
+        if (!key.end_effectors.empty() && s.key != "soma30") return std::unexpected("end-effector keys need the SOMA30 model");
+    }
+    // upstream SOMASkeleton30.expand_joint_names: chain positions, the chain's first joint rotated
+    auto chains = [&](const pose_key &key, std::vector<unsigned> &positions, std::vector<unsigned> &rotations) -> std::expected<void, std::string> {
+        for (const auto &name : key.end_effectors) {
+            std::vector<std::string_view> chain;
+            if (name == "LeftHand") chain = {"LeftHand", "LeftHandMiddleEnd"};
+            else if (name == "RightHand") chain = {"RightHand", "RightHandMiddleEnd"};
+            else if (name == "LeftFoot") chain = {"LeftFoot", "LeftToeBase"};
+            else if (name == "RightFoot") chain = {"RightFoot", "RightToeBase"};
+            else if (name == "Hips") chain = {"Hips"};
+            else return std::unexpected("unknown end effector " + name);
+            for (size_t i = 0; i < chain.size(); ++i) {
+                const auto found = std::find(s.names.begin(), s.names.end(), chain[i]);
+                const auto joint = static_cast<unsigned>(found - s.names.begin());
+                positions.push_back(joint);
+                if (!i) rotations.push_back(joint);
+            }
+            positions.push_back(0);
+        }
+        return {};
+    };
+    auto embedding = impl_->text->encode(utf8_prompt);
+    if (!embedding) return std::unexpected(embedding.error());
+    const std::lock_guard inference_lock(impl_->inference_mutex);
+    if (!impl_->weights) {
+        auto loaded = detail::ggml_motion_weights::load(impl_->motion_path);
+        if (!loaded) return std::unexpected(loaded.error());
+        impl_->weights = std::move(*loaded);
+    }
+    auto gm=impl_->weights->f32_values("stats.global_root.mean"), gs=impl_->weights->f32_values("stats.global_root.std");
+    auto bm=impl_->weights->f32_values("stats.body.mean"), bs=impl_->weights->f32_values("stats.body.std");
+    if (!gm || !gs || !bm || !bs) return std::unexpected("motion GGUF lacks normalization statistics");
+    // Upstream normalizes the whole observed tensor; only masked cells reach
+    // the constraint branch (x*(1-mask) + observed*mask), so zeros elsewhere.
+    std::vector<float> observed(frames*D, 0.F), mask(frames*D, 0.F);
+    float heading = 0.F;
+    // Keys on one frame merge their masks (a fullbody and an end-effector key of
+    // the same pose); each frame is normalized once.
+    std::vector<bool> keyed(frames, false);
+    for (const auto &key : keys) {
+        std::vector<unsigned> positions, rotations;
+        if (auto expanded = chains(key, positions, rotations); !expanded) return std::unexpected(expanded.error());
+        if (key.end_effectors.empty()) positions.clear();
+        const float angle = detail::pose_condition(s, key.local_axis_angle, key.root_position.data(),
+            key.has_smooth_root_2d ? key.smooth_root_2d.data() : nullptr, positions, rotations,
+            observed.data()+key.frame*D, mask.data()+key.frame*D);
+        if (key.frame == 0) heading = angle;
+        keyed[key.frame] = true;
+    }
+    for (unsigned frame = 0; frame < frames; ++frame) {
+        if (!keyed[frame]) continue;
+        float *row = observed.data()+frame*D; const float *row_mask = mask.data()+frame*D;
+        for (size_t j=0; j<J; ++j) if (row_mask[5+j*3] > 0.F) { row[5+j*3] -= row[0]; row[7+j*3] -= row[2]; }
+        for (size_t d=0; d<5; ++d) row[d]=(row[d]-(*gm)[d])/std::sqrt((*gs)[d]*(*gs)[d]+1.e-5F);
+        for (size_t d=0; d<body; ++d) row[5+d]=(row[5+d]-(*bm)[d])/std::sqrt((*bs)[d]*(*bs)[d]+1.e-5F);
+        for (size_t d=0; d<D; ++d) row[d]*=row_mask[d];
+    }
+    std::mt19937_64 rng(seed);
+    std::normal_distribution<float> normal(0.f, 1.f);
+    std::vector<float> noise(static_cast<size_t>(frames)*D);
+    for (float &value : noise) value = normal(rng);
+    auto sampled = detail::sample_motion_from_noise_conditioned(*impl_->weights, noise, *embedding, observed, mask,
+                                                                heading, frames, steps, text_cfg, constraint_cfg);
+    if (!sampled) return std::unexpected(sampled.error());
+    auto decoded = detail::decode_motion(*sampled, frames, s, *gm, *gs, *bm, *bs);
+    if (!decoded) return std::unexpected(decoded.error());
+    motion_data result; result.frames=frames; result.joints=static_cast<unsigned>(J);
+    result.local_rotations_xyzw=std::move(decoded->local_xyzw); result.root_positions=std::move(decoded->root_positions);
+    return result;
+#else
+    (void) utf8_prompt; (void) keys; (void) frames; (void) steps; (void) seed; (void) text_cfg; (void) constraint_cfg;
+    return std::unexpected("Kimodo was built without GGML support");
+#endif
+}
