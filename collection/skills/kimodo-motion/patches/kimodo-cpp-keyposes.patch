+// Just enough JSON for upstream's constraints file (`kimodo --constraints`):
+// a list of objects with numbers, strings and nested lists.
+struct json {
+    enum kind_t { null, number, string, array, object } kind = null;
+    double num = 0;
+    std::string str;
+    std::vector<json> items;
+    std::vector<std::pair<std::string, json>> fields;
+    const json *get(std::string_view key) const {
+        for (const auto &[name, value] : fields) if (name == key) return &value;
+        return nullptr;
+    }
+};
+
+struct json_parser {
+    std::string_view text;
+    size_t at = 0;
+    void space() { while (at < text.size() && std::isspace(static_cast<unsigned char>(text[at]))) ++at; }
+    [[noreturn]] void fail(const char *what) { throw std::runtime_error("constraints JSON: " + std::string(what) + " at byte " + std::to_string(at)); }
+    bool eat(char c) { space(); if (at < text.size() && text[at] == c) { ++at; return true; } return false; }
+    std::string string() {
+        if (!eat('"')) fail("expected a string");
+        std::string out;
+        while (at < text.size() && text[at] != '"') { if (text[at] == '\\') ++at; if (at < text.size()) out += text[at++]; }
+        if (!eat('"')) fail("unterminated string");
+        return out;
+    }
+    json value() {
+        space();
+        json v;
+        if (at >= text.size()) fail("unexpected end");
+        const char c = text[at];
+        if (c == '{') {
+            ++at; v.kind = json::object;
+            if (eat('}')) return v;
+            do { auto key = string(); if (!eat(':')) fail("expected ':'"); v.fields.emplace_back(key, value()); } while (eat(','));
+            if (!eat('}')) fail("expected '}'");
+        } else if (c == '[') {
+            ++at; v.kind = json::array;
+            if (eat(']')) return v;
+            do v.items.push_back(value()); while (eat(','));
+            if (!eat(']')) fail("expected ']'");
+        } else if (c == '"') {
+            v.kind = json::string; v.str = string();
+        } else if (text.substr(at, 4) == "null") {
+            at += 4;
+        } else {
+            const std::string rest(text.substr(at, 64));
+            size_t used = 0;
+            try { v.num = std::stod(rest, &used); } catch (const std::exception &) { fail("expected a value"); }
+            v.kind = json::number; at += used;
+        }
+        return v;
+    }
+};
+
+std::vector<float> numbers(const json *value, const char *name) {
+    if (!value) throw std::runtime_error(std::string("constraint lacks ") + name);
+    std::vector<float> out;
+    auto walk = [&](auto &self, const json &v) -> void {
+        if (v.kind == json::number) out.push_back(static_cast<float>(v.num));
+        else if (v.kind == json::array) for (const auto &item : v.items) self(self, item);
+        else throw std::runtime_error(std::string("constraint field ") + name + " must hold numbers");
+    };
+    walk(walk, *value);
+    return out;
+}
+
+// Upstream key-pose entries: `fullbody`, `end-effector` (joint_names) and its
+// shorthands left-hand/right-hand/left-foot/right-foot, each with
+// frame_indices [T], local_joints_rot [T,J,3] axis-angle, root_positions [T,3]
+// and optional smooth_root_2d [T,2] (root2d is not read yet). The joint count
+// comes from the data; the model checks it against its skeleton.
+std::vector<kimodo::pose_key> read_keyposes(const std::filesystem::path &path) {
+    std::ifstream file(path);
+    const std::string text{std::istreambuf_iterator<char>(file), {}};
+    if (!file && text.empty()) throw std::runtime_error("cannot read constraints " + path.string());
+    json_parser parser{text};
+    const json root = parser.value();
+    if (root.kind != json::array) throw std::runtime_error("constraints JSON must be a list");
+    std::vector<kimodo::pose_key> keys;
+    for (const auto &item : root.items) {
+        const json *type = item.get("type");
+        const std::string kind = type ? type->str : std::string();
+        std::vector<std::string> end_effectors;
+        if (kind == "left-hand") end_effectors = {"LeftHand"};
+        else if (kind == "right-hand") end_effectors = {"RightHand"};
+        else if (kind == "left-foot") end_effectors = {"LeftFoot"};
+        else if (kind == "right-foot") end_effectors = {"RightFoot"};
+        else if (kind == "end-effector") {
+            const json *names = item.get("joint_names");
+            if (!names || names->kind != json::array || names->items.empty()) throw std::runtime_error("end-effector lacks joint_names");
+            for (const auto &name : names->items) end_effectors.push_back(name.str);
+        } else if (kind != "fullbody")
+            throw std::runtime_error("unsupported constraint type '" + kind + "' (fullbody, end-effector, left/right-hand/foot)");
+        const auto frames = numbers(item.get("frame_indices"), "frame_indices");
+        const auto rotations = numbers(item.get("local_joints_rot"), "local_joints_rot");
+        const auto roots = numbers(item.get("root_positions"), "root_positions");
+        const json *smooth = item.get("smooth_root_2d");
+        const auto smooth_values = smooth && smooth->kind != json::null ? numbers(smooth, "smooth_root_2d") : std::vector<float>{};
+        const size_t count = frames.size();
+        if (!count || rotations.size() % (count*3)) throw std::runtime_error("local_joints_rot must be [T,J,3]");
+        const size_t joints = rotations.size() / (count*3);
+        if (roots.size() != count*3 || (!smooth_values.empty() && smooth_values.size() != count*2))
+            throw std::runtime_error("root_positions / smooth_root_2d do not match frame_indices");
+        for (size_t t = 0; t < count; ++t) {
+            if (frames[t] < 0) throw std::runtime_error("negative frame index");
+            kimodo::pose_key key;
+            key.frame = static_cast<unsigned>(frames[t]);
+            key.end_effectors = end_effectors;
+            key.local_axis_angle.assign(rotations.begin() + static_cast<std::ptrdiff_t>(t*joints*3),
+                                        rotations.begin() + static_cast<std::ptrdiff_t>((t+1)*joints*3));
+            key.root_position = {roots[t*3], roots[t*3+1], roots[t*3+2]};
+            if (!smooth_values.empty()) { key.has_smooth_root_2d = true; key.smooth_root_2d = {smooth_values[t*2], smooth_values[t*2+1]}; }
+            keys.push_back(std::move(key));
+        }
+    }
+    return keys;
+}
+
+// Constraint CFG weight for key poses: KIMODO_CONSTRAINT_CFG, default 2 as upstream.
+float constraint_cfg() {
+    const char *value = std::getenv("KIMODO_CONSTRAINT_CFG");
+    return value ? std::stof(value) : 2.F;
+}
