+float pose_condition(const skeleton_spec &s, std::span<const float> axis_angle,
+                     const float root[3], const float *smooth_root_2d, std::span<const unsigned> positions,
+                     std::span<const unsigned> rotations, float *value, float *mask) {
+    const size_t J=s.joints(),rotation_begin=5+3*J;
+    std::vector<mat> global(J);
+    std::vector<std::array<float,3>> posed(J);
+    for(size_t j=0;j<J;++j){
+        const double x=axis_angle[j*3],y=axis_angle[j*3+1],z=axis_angle[j*3+2],angle=std::sqrt(x*x+y*y+z*z);
+        mat local{{1,0,0,0,1,0,0,0,1}};
+        if(angle>1e-12){const double c=std::cos(angle),si=std::sin(angle),t=1-c,a=x/angle,b=y/angle,d=z/angle;
+            local={{t*a*a+c,t*a*b-si*d,t*a*d+si*b,t*a*b+si*d,t*b*b+c,t*b*d-si*a,t*a*d-si*b,t*b*d+si*a,t*d*d+c}};}
+        const int parent=s.parents[j];
+        if(parent<0){global[j]=local;posed[j]={root[0],root[1],root[2]};continue;}
+        global[j]=mul(global[static_cast<size_t>(parent)],local);
+        float offset[3];rotate(global[static_cast<size_t>(parent)],s.offsets[j],offset);
+        for(int k=0;k<3;++k)posed[j][k]=posed[static_cast<size_t>(parent)][k]+offset[k];
+    }
+    const auto right=s.hips[0],left=s.hips[1];
+    const float angle=std::atan2(posed[right][2]-posed[left][2],-(posed[right][0]-posed[left][0]));
+    // Smooth root x/z default to the pelvis; y is the pelvis height. Only this
+    // key's features are written: another key on the same frame (the other
+    // hand) keeps its own. Positions stay global here; the caller subtracts
+    // the frame's final smooth root x/z (create_conditions after merging).
+    const float sx=smooth_root_2d?smooth_root_2d[0]:root[0],sz=smooth_root_2d?smooth_root_2d[1]:root[2];
+    value[0]=sx;value[1]=root[1];value[2]=sz;value[3]=std::cos(angle);value[4]=std::sin(angle);
+    std::fill(mask,mask+5,1.F);
+    auto position=[&](size_t j){value[5+j*3]=posed[j][0];value[6+j*3]=posed[j][1];value[7+j*3]=posed[j][2];std::fill(mask+5+j*3,mask+8+j*3,1.F);};
+    if(positions.empty())for(size_t j=0;j<J;++j)position(j);
+    for(unsigned j:positions)position(j);
+    for(unsigned j:rotations){for(int d=0;d<6;++d)value[rotation_begin+j*6+static_cast<size_t>(d)]=static_cast<float>(global[j].v[(d%3)*3+d/3]);std::fill(mask+rotation_begin+j*6,mask+rotation_begin+j*6+6,1.F);}
+    return angle;
+}
