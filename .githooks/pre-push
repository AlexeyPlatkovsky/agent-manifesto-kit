#!/bin/sh
# Pre-push hook — verifies branch names for release hygiene.

BRANCH=$(git rev-parse --abbrev-ref HEAD)

case "$BRANCH" in
  feat/amk-[0-9][0-9][0-9]-*|fix/amk-[0-9][0-9][0-9]-*)
    exit 0
    ;;
  *)
    echo "pre-push: direct pushes to main are forbidden." >&2
    echo "pre-push: work branches must use feat/amk-NNN-slug or fix/amk-NNN-slug." >&2
    echo "pre-push: current branch is '$BRANCH'." >&2
    exit 1
    ;;
esac
