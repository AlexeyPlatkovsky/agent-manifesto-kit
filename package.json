{
  "name": "agent-manifesto-kit",
  "version": "1.1.0",
  "description": "CLI to discover and adopt Agent Manifesto Kit capabilities (skills, agents, pipelines) into your project for Claude, Codex, or AI-agnostic targets.",
  "type": "module",
  "bin": {
    "agentkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "collection"
  ],
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude",
    "codex",
    "spec-driven-development",
    "cli",
    "agent-manifesto"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "version-branch": "node .ai/scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Alexey Platkovsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexeyPlatkovsky/agent-manifesto-kit.git"
  },
  "homepage": "https://github.com/AlexeyPlatkovsky/agent-manifesto-kit#readme",
  "bugs": {
    "url": "https://github.com/AlexeyPlatkovsky/agent-manifesto-kit/issues"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "semantic-release": "^25.0.5",
    "typescript": "^5.6.0"
  }
}
